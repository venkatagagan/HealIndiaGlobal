# Normalize line endings: LF in the repository and working tree, except Windows scripts.
* text=auto eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

# Lock files: treat as generated (collapsed in diffs, no merge noise)
package-lock.json     linguist-generated=true -diff
pubspec.lock          linguist-generated=true
requirements.lock.txt linguist-generated=true

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.jar   binary
*.keystore binary
*.jks   binary
