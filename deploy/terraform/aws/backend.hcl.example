# Partial backend configuration (terraform init -backend-config=backend-production.hcl).
# Values come from the outputs of ./bootstrap. Use a different `key` per environment.
bucket         = "hig-terraform-state-123456789012"
key            = "heal-india-global/production/terraform.tfstate"
region         = "ap-south-1"
encrypt        = true
kms_key_id     = "arn:aws:kms:ap-south-1:123456789012:key/00000000-0000-0000-0000-000000000000"
dynamodb_table = "hig-terraform-locks"
