# Secrets Manager entries injected into the ECS task definitions (never into images or tfvars).
#
# Generated here (values live in the encrypted remote state - restrict access to the state bucket):
#   DATABASE_URL, REDIS_URL, JWT_SECRET, FIELD_ENCRYPTION_KEY, DB_APP_CREDENTIALS (for db-bootstrap only),
#   REVALIDATE_SECRET (on-demand website revalidation; the SAME secret goes to the website task - give its
#   execution role GetSecretValue on it and inject it as REVALIDATE_SECRET)
# Created EMPTY here and filled out-of-band with deploy/scripts/set-secret.sh (third-party credentials):
#   RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET   (when "razorpay" in payment_gateways)
#   STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET (when "stripe" in payment_gateways)
#   ANTHROPIC_API_KEY                                               (when ai_enabled)
#   SMTP_USER, SMTP_PASSWORD                                        (when email_backend = "smtp")
# ECS refuses to start tasks while a referenced secret has no value, so a forgotten secret fails loudly.
#
# Secret names: <project>/<environment>/<NAME>, e.g. hig/production/JWT_SECRET.

resource "random_password" "db_app" {
  length  = 40
  special = false # URL-safe: embedded in DATABASE_URL
}

resource "random_password" "redis_auth" {
  length  = 64
  special = false # ElastiCache AUTH tokens forbid @ " / and spaces; also URL-safe
}

resource "random_password" "jwt_secret" {
  length  = 64
  special = false
}

# 32 random bytes, base64 (44 chars) - AES-256-GCM key for field encryption. NEVER rotate this without a
# re-encryption migration: passports, bank accounts, PAN and MFA secrets become unreadable.
resource "random_bytes" "field_encryption_key" {
  length = 32
}

# Shared secret of the backend worker (sender) and the public website (POST /api/revalidate receiver).
resource "random_password" "revalidate_secret" {
  length  = 48
  special = false
}

# Shared secret CloudFront sends to the ALB (X-Origin-Verify).
resource "random_password" "origin_verify" {
  length  = 48
  special = false
}

locals {
  secret_prefix = "${var.project}/${var.environment}"

  database_url = format(
    "postgresql+asyncpg://%s:%s@%s:%d/%s?ssl=require",
    var.db_app_username,
    random_password.db_app.result,
    aws_db_instance.postgres.address,
    aws_db_instance.postgres.port,
    var.db_name,
  )

  redis_url = format(
    "rediss://:%s@%s:6379/0",
    random_password.redis_auth.result,
    aws_elasticache_replication_group.redis.primary_endpoint_address,
  )

  generated_secret_keys = ["DATABASE_URL", "REDIS_URL", "JWT_SECRET", "FIELD_ENCRYPTION_KEY", "DB_APP_CREDENTIALS", "REVALIDATE_SECRET"]

  generated_secret_values = {
    DATABASE_URL         = local.database_url
    REDIS_URL            = local.redis_url
    JWT_SECRET           = random_password.jwt_secret.result
    FIELD_ENCRYPTION_KEY = random_bytes.field_encryption_key.base64
    REVALIDATE_SECRET    = random_password.revalidate_secret.result
    DB_APP_CREDENTIALS = jsonencode({
      username = var.db_app_username
      password = random_password.db_app.result
    })
  }

  external_secret_keys = concat(
    contains(var.payment_gateways, "razorpay") ? ["RAZORPAY_KEY_ID", "RAZORPAY_KEY_SECRET", "RAZORPAY_WEBHOOK_SECRET"] : [],
    contains(var.payment_gateways, "stripe") ? ["STRIPE_SECRET_KEY", "STRIPE_PUBLISHABLE_KEY", "STRIPE_WEBHOOK_SECRET"] : [],
    var.ai_enabled ? ["ANTHROPIC_API_KEY"] : [],
    var.email_backend == "smtp" ? ["SMTP_USER", "SMTP_PASSWORD"] : [],
    length(var.apple_client_ids) > 0 ? ["APPLE_PRIVATE_KEY"] : [],
  )
}

resource "aws_secretsmanager_secret" "generated" {
  for_each = toset(local.generated_secret_keys)

  name                    = "${local.secret_prefix}/${each.key}"
  description             = "Heal India Global ${var.environment}: ${each.key} (generated by Terraform)"
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = var.secrets_recovery_window_days

  dynamic "replica" {
    for_each = var.enable_dr ? [var.dr_region] : []

    content {
      region     = replica.value
      kms_key_id = aws_kms_key.dr[0].arn
    }
  }
}

resource "aws_secretsmanager_secret_version" "generated" {
  for_each = toset(local.generated_secret_keys)

  secret_id     = aws_secretsmanager_secret.generated[each.key].id
  secret_string = local.generated_secret_values[each.key]
}

resource "aws_secretsmanager_secret" "external" {
  for_each = toset(local.external_secret_keys)

  name                    = "${local.secret_prefix}/${each.key}"
  description             = "Heal India Global ${var.environment}: ${each.key} (set with deploy/scripts/set-secret.sh)"
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = var.secrets_recovery_window_days

  dynamic "replica" {
    for_each = var.enable_dr ? [var.dr_region] : []

    content {
      region     = replica.value
      kms_key_id = aws_kms_key.dr[0].arn
    }
  }
}

locals {
  # Everything the api/worker containers receive (DB_APP_CREDENTIALS is for db-bootstrap only). REVALIDATE_SECRET
  # only once website_revalidate_url is set: with a secret but no URL the worker would retry a dead endpoint.
  app_secret_arns = merge(
    {
      for k in local.generated_secret_keys : k => aws_secretsmanager_secret.generated[k].arn
      if k != "DB_APP_CREDENTIALS" && (k != "REVALIDATE_SECRET" || var.website_revalidate_url != "")
    },
    { for k in local.external_secret_keys : k => aws_secretsmanager_secret.external[k].arn },
  )

  # The migration task only needs the database plus the values production settings validation requires.
  migrate_secret_arns = {
    for k in ["DATABASE_URL", "JWT_SECRET", "FIELD_ENCRYPTION_KEY"] : k => aws_secretsmanager_secret.generated[k].arn
  }
}
