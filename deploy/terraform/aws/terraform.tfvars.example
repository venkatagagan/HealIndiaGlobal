# Heal India Global - example variables (production). Copy to production.tfvars (or terraform.tfvars) and
# adjust. NEVER put secrets here: secrets are generated by Terraform or set with deploy/scripts/set-secret.sh.
#
#   terraform apply -var-file=production.tfvars -var="image_tag=$(git rev-parse --short=12 HEAD)"

project     = "hig"
environment = "production"
aws_region  = "ap-south-1"

tags = {
  Owner      = "platform-team"
  CostCenter = "heal-india-global"
}

# ---- DNS / TLS -------------------------------------------------------------------------------------
domain_name     = "healindia.example"
route53_zone_id = "Z0123456789EXAMPLE" # public hosted zone of domain_name; "" = manage DNS yourself
# Hostnames default to: healindia.example, agent.healindia.example, hospital.healindia.example,
# admin.healindia.example, api.healindia.example and origin-api.healindia.example (CloudFront -> ALB only).
# hostnames = { patient = "www.healindia.example" }
# Bring your own issued certificates instead of DNS-validated ones:
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/..."
# alb_certificate_arn        = "arn:aws:acm:ap-south-1:123456789012:certificate/..."

# ---- Network ---------------------------------------------------------------------------------------
vpc_cidr                   = "10.40.0.0/16"
az_count                   = 3
nat_gateway_mode           = "per_az" # staging: "single"
enable_interface_endpoints = false

# ---- Edge ------------------------------------------------------------------------------------------
cloudfront_price_class = "PriceClass_All"
admin_allowed_cidrs    = [] # e.g. ["203.0.113.0/24"] office / VPN egress ranges
waf_auth_rate_limit    = 300
waf_global_rate_limit  = 6000

# ---- Containers ------------------------------------------------------------------------------------
# image_tag is passed on the command line (git SHA).
cpu_architecture          = "X86_64"
api_cpu                   = 512
api_memory                = 1024
api_min_count             = 2
api_max_count             = 10
web_concurrency           = 1
worker_cpu                = 512
worker_memory             = 1024
worker_min_count          = 1
worker_max_count          = 4
worker_concurrency        = 4
worker_use_fargate_spot   = false
start_services            = true # false for the very first apply (see deploy/README.md)
enable_ecs_exec           = false
enable_container_insights = true
log_retention_days        = 90
metrics_scrape_cidrs      = [] # e.g. ["10.40.16.0/20"] where the Prometheus / ADOT collector runs

# ---- Application -----------------------------------------------------------------------------------
payment_gateways           = ["razorpay", "bank_transfer"] # add "stripe" if used; never "mock" in production
ai_enabled                 = true
ai_model                   = "claude-opus-5-5"
ai_effort                  = "medium"
email_backend              = "smtp"
smtp_host                  = "email-smtp.ap-south-1.amazonaws.com"
smtp_port                  = 587
email_from                 = "Heal India Global <no-reply@healindia.example>"
google_client_ids          = [] # public OAuth client ids (web, android, ios)
apple_client_ids           = [] # Sign in with Apple audiences; non-empty creates the APPLE_PRIVATE_KEY secret
apple_team_id              = ""
apple_key_id               = ""
staff_allowed_cidrs        = [] # e.g. ["203.0.113.0/24"] - office / VPN egress for the staff door
admin_mfa_required         = true
require_email_verification = true
max_upload_mb              = 15
db_pool_size               = 5
db_max_overflow            = 10

# ---- Data ------------------------------------------------------------------------------------------
rds_instance_class        = "db.t4g.medium" # db.m7g.large once sustained CPU > 40% or connections > 200
rds_allocated_storage     = 50
rds_max_allocated_storage = 500
rds_multi_az              = true # staging: false
rds_backup_retention_days = 14
rds_deletion_protection   = true
redis_node_type           = "cache.t4g.small"
redis_num_cache_clusters  = 2 # staging: 1

# ---- Backup / DR -----------------------------------------------------------------------------------
enable_dr                     = true # requires the ap-south-2 opt-in region to be enabled
dr_region                     = "ap-south-2"
backup_daily_retention_days   = 35
backup_monthly_retention_days = 365
dr_backup_retention_days      = 35

# ---- Alerting --------------------------------------------------------------------------------------
alarm_emails              = ["oncall@healindia.example"]
alarm_5xx_ratio_percent   = 2
alarm_p95_latency_seconds = 2
alarm_rds_connections     = 300

# ---------------------------------------------------------------------------------------------------
# Staging differences (staging.tfvars):
#   environment = "staging"            -> staging.healindia.example, agent.staging.healindia.example, ...
#   nat_gateway_mode = "single"; rds_instance_class = "db.t4g.small"; rds_multi_az = false
#   redis_num_cache_clusters = 1; api_min_count = 1; api_max_count = 3; worker_max_count = 2
#   enable_dr = false; alb_deletion_protection = false; rds_deletion_protection = false
#   secrets_recovery_window_days = 7; payment_gateways = ["razorpay", "bank_transfer", "mock"]
# ---------------------------------------------------------------------------------------------------

# Public website integration (the website is not part of this stack yet - see deploy/README.md "CDN and caching").
# website_revalidate_url = "http://website.hig.internal:3000/api/revalidate"   # empty = on-demand revalidation off
# website_server_cidrs   = ["10.40.0.0/16"]
# catalog_rate_limit_public  = 300
# catalog_rate_limit_website = 6000
