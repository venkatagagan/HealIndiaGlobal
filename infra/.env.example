# =====================================================================================================
# Heal India Global - docker compose environment (copy to infra/.env and fill in; NEVER commit .env)
#
#   cp infra/.env.example infra/.env
#   docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build
#
# Generate secrets with e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"                                # JWT_SECRET
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"      # FIELD_ENCRYPTION_KEY
#   python -c "import secrets; print(secrets.token_hex(24))"                                    # DB/Redis/MinIO passwords
# Use URL-safe characters (hex is simplest) for the database and Redis passwords: they are embedded
# into connection URLs by docker-compose.yml.
# =====================================================================================================

# ---- Compose / images ----------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=healindia
IMAGE_TAG=local
API_IMAGE=healindia/api
WEB_IMAGE=healindia/web
WEBSITE_IMAGE=healindia/website
# MinIO image (only with `--profile s3`); pin a RELEASE.* tag in production.
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

# ---- Public domain served by the edge nginx (TLS certs in infra/nginx/certs/) -------------------------
# One domain, path routing (PLAN section 3.1): / website, /app/ patient, /agent/, /hospital/, /gahi/ staff
# console, /api/ backend. `localhost` works out of the box with the self-signed certificate from certs-init.
SITE_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Docker network of the edge/app containers. The api trusts X-Forwarded-* ONLY from EDGE_IPV4 (never "*").
# Change both together if the subnet clashes with a local network.
APP_SUBNET=172.29.10.0/24
EDGE_IPV4=172.29.10.10
# Fixed address of the website container: the api gives it the generous public-catalogue rate limit
# (WEBSITE_SERVER_IPS) for server-side rendering / ISR. Must be inside APP_SUBNET.
WEBSITE_IPV4=172.29.10.11
# Subject for the self-signed fallback certificate (ignored once real certs are present).
SELF_SIGNED_CN=localhost

# ---- Application ---------------------------------------------------------------------------------------
# development | test | staging | production  (production enforces strong secrets, secure cookies, no mock gateway)
ENV=production
APP_NAME=Heal India Global
API_BASE_URL=https://localhost
PATIENT_WEB_URL=https://localhost
AGENT_PORTAL_URL=https://localhost/agent
HOSPITAL_PORTAL_URL=https://localhost/hospital
ADMIN_PORTAL_URL=https://localhost/gahi
# The single public domain (website + login door); emails and redirects link here.
PUBLIC_SITE_URL=https://localhost
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_DOCS=false
SENTRY_DSN=

# ---- PostgreSQL (container) ----------------------------------------------------------------------------
# Three roles (infra/postgres/init/02-roles.sh):
#   POSTGRES_USER     bootstrap superuser - init scripts and operators only, never the application
#   MIGRATOR_DB_USER  owns the schema; used only by the one-off `migrate` service (alembic upgrade head)
#   APP_DB_USER       api + worker; SELECT/INSERT/UPDATE/DELETE only (no DDL, no TRUNCATE)
# Existing volume created with the old single-role setup: set these, then run
#   docker compose -f infra/docker-compose.yml --env-file infra/.env exec postgres sh /docker-entrypoint-initdb.d/02-roles.sh
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-hex-password
POSTGRES_DB=healindia
MIGRATOR_DB_USER=healindia_migrator
MIGRATOR_DB_PASSWORD=change-me-hex-password
APP_DB_USER=healindia_app
APP_DB_PASSWORD=change-me-hex-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Redis (container) ---------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-hex-password
REDIS_MAXMEMORY=256mb

# ---- API / worker processes ----------------------------------------------------------------------------
# Gunicorn worker processes per api container (rule of thumb: 2 x CPU cores + 1, bounded by DB pool size).
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
# The worker container runs jobs; keep the embedded worker off in the API.
RUN_WORKER_IN_API=false
WORKER_POLL_INTERVAL_SECONDS=2
RATE_LIMIT_ENABLED=true

# ---- Auth / security -----------------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=heal-india-global
JWT_AUDIENCE=hig-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# 32 random bytes, url-safe base64 (44 chars). Losing this key makes encrypted fields unreadable - back it up.
FIELD_ENCRYPTION_KEY=
# Everything is same-origin behind the edge, so no cross-origin browser access is needed.
CORS_ORIGINS=
# Dev-only regex; ignored when ENV=production.
CORS_ORIGIN_REGEX=
COOKIE_SECURE=true
COOKIE_DOMAIN=
TRUSTED_HOSTS=*
ADMIN_MFA_REQUIRED=true
# Comma-separated CIDRs allowed to use the staff door (/auth/staff/*) and staff APIs. The edge can
# additionally hide /gahi/ itself: infra/nginx/snippets/staff-access.conf.
# SEC-022: ENV=production refuses to start unless STAFF_ALLOWED_IPS and/or STAFF_CONSOLE_ORIGIN is set.
STAFF_ALLOWED_IPS=
# Origin of a separately hosted staff console, e.g. https://ops.example.com (see deploy/README.md, "Staff
# console origin"). When set, /auth/staff/* only accepts browser requests from exactly this origin.
STAFF_CONSOLE_ORIGIN=
REQUIRE_EMAIL_VERIFICATION=true
# Comma-separated OAuth client ids accepted for Google sign-in (web + Android + iOS).
GOOGLE_CLIENT_IDS=
# Sign in with Apple: accepted audiences (iOS bundle id, web Services ID), team id, key id and the PKCS#8 PEM
# private key (SECRET; one line with \n escapes). Needed to revoke Apple tokens on account deletion.
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ---- AI screening (Claude) -----------------------------------------------------------------------------
# Empty key => deterministic rules engine.
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_TIMEOUT_SECONDS=90
# Voice intake. ENV=production refuses anything but local_whisper / false.
STT_PROVIDER=local_whisper
VOICE_RETAIN_AUDIO=false

# ---- Storage -------------------------------------------------------------------------------------------
# local => named volume shared by api + worker; s3 => any S3-compatible store (start MinIO with --profile s3)
STORAGE_BACKEND=local
MAX_UPLOAD_MB=15
S3_BUCKET=healindia-documents
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO root credentials (profile s3). The init job creates S3_BUCKET; use a dedicated access key in prod.
MINIO_ROOT_USER=healindia-minio
MINIO_ROOT_PASSWORD=change-me-hex-password

# ---- Email ---------------------------------------------------------------------------------------------
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Heal India Global <no-reply@healindia.example>

# ---- Payments ------------------------------------------------------------------------------------------
# Comma-separated: razorpay,stripe,bank_transfer (mock is refused in production)
PAYMENT_GATEWAYS_ENABLED=razorpay,bank_transfer
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
BASE_CURRENCY=INR
DEFAULT_PATIENT_CURRENCY=USD

# ---- Web build-time variables (baked into the SPA bundles by `docker compose build web`) -------------
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_CLIENT_ID=
VITE_PATIENT_WEB_URL=https://localhost
VITE_PATIENT_APP_URL=https://localhost/app/
VITE_AGENT_PORTAL_URL=https://localhost/agent/
VITE_HOSPITAL_PORTAL_URL=https://localhost/hospital/
VITE_ADMIN_PORTAL_URL=https://localhost/gahi/
VITE_PUBLIC_SITE_URL=https://localhost
VITE_WEBSITE_URL=https://localhost
VITE_PUBLIC_LOGIN_URL=https://localhost/login
VITE_PUBLIC_REGISTER_URL=https://localhost/register
VITE_PUBLIC_FORGOT_PASSWORD_URL=https://localhost/forgot-password

# ---- Public website (Next.js; NEXT_PUBLIC_* are baked in by `docker compose build website`) ---------
NEXT_PUBLIC_SITE_URL=https://localhost
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_PATIENT_APP_URL=https://localhost/app/
NEXT_PUBLIC_AGENT_PORTAL_URL=https://localhost/agent/
NEXT_PUBLIC_HOSPITAL_PORTAL_URL=https://localhost/hospital/
NEXT_PUBLIC_STAFF_URL=https://localhost/gahi/
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Runtime: build = fallback catalogue only at build time; runtime API errors keep serving the last good page.
WEBSITE_DATA_FALLBACK=build
WEBSITE_REVALIDATE_SECONDS=300
WEBSITE_IMAGE_REMOTE_ORIGINS=
WEBSITE_NOINDEX=false
# Canonical public origin (sitemap, canonical URLs, JSON-LD); baked in at build time AND read at runtime.
# NEXT_PUBLIC_SITE_URL is set above. Production: https://<SITE_DOMAIN>.
# true = never publish sample (fallback) catalogue data. Applies to the RUNNING site (ISR renders keep the last
# good page instead). The image build cannot reach the API, so it is forced to false at build time
# (infra/website/Dockerfile); after a deploy, trigger a full refresh (deploy/README.md "Revalidation").
SITE_REQUIRE_LIVE_DATA=true
# false = only content with review_status "approved" is published (production). Build time and runtime.
CONTENT_INCLUDE_DRAFTS=false
# On-demand ISR revalidation shared secret: the worker POSTs changed catalogue tags to
# WEBSITE_REVALIDATE_URL with this secret; the website's /api/revalidate checks it. The SAME value is passed to
# api, worker and website. At least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = revalidation off (pages still refresh every WEBSITE_REVALIDATE_SECONDS). Never commit a real value.
REVALIDATE_SECRET=
# Worker -> website, inside the compose network (never through the edge: /api/ there is the FastAPI API).
WEBSITE_REVALIDATE_URL=http://website:3000/api/revalidate
# Public catalogue rate limits in the api (requests per minute per client IP; the website gets its own budget).
CATALOG_RATE_LIMIT_PUBLIC=300
CATALOG_RATE_LIMIT_WEBSITE=6000
# Search-console ownership meta tags (build time AND runtime: pages are prerendered). Empty = no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Analytics (build time): empty = off | plausible (cookieless) | ga4 (only after consent). See website/.env.example.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
