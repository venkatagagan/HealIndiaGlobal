# Staff console host (SEC-022) for the AWS starter - rendered by deploy/starter/deploy.sh into
# /opt/hig/nginx-extra/server-ops-console.conf (mounted at /etc/nginx/extra.d by infra/docker-compose.aws.yml and
# included in the http block of nginx.conf). Tokens: __STAFF_HOST__ (e.g. ops.healindiaglobal.ai) and
# __STAFF_ALLOW__ (allow/deny lines from allowed_staff_cidrs; empty = no IP restriction).
#
# The console gets its own origin: only the admin SPA (/gahi/) and the API are served here - no website, no
# portal pages with third-party scripts - and the API sets STAFF_CONSOLE_ORIGIN=https://__STAFF_HOST__, so the
# staff door refuses every other origin. Staff accounts need MFA (ADMIN_MFA_REQUIRED=true in production).

# Strict budget for every authentication call on this host (staff login, MFA setup, password change).
limit_req_zone $binary_remote_addr zone=ops_auth_zone:5m rate=10r/m;

server {
    listen 443 ssl;
    http2 on;
    server_name __STAFF_HOST__;
    include /etc/nginx/snippets/ssl.conf;
    absolute_redirect off;

    limit_conn conn_per_ip 50;
__STAFF_ALLOW__

    error_page 429 = @ops_rate_limited;
    location @ops_rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        add_header X-Request-ID $request_id always;
        return 429 '{"error":{"code":"rate_limited","message":"Too many requests, please slow down.","details":null,"request_id":"$request_id"}}';
    }

    # ---- console -----------------------------------------------------------------------------------
    location = / { return 302 /gahi/; }
    location = /gahi { return 301 /gahi/; }
    location /gahi/assets/ {
        include /etc/nginx/snippets/spa-assets.conf;
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://web_admin/assets/;
    }
    location /gahi/ {
        include /etc/nginx/snippets/spa-shell-staff.conf;   # strict CSP: no third-party scripts
        add_header X-Robots-Tag "noindex, nofollow" always;
        proxy_pass http://web_admin/;
    }

    # ---- authentication: strict per-IP budgets ---------------------------------------------------------
    location /api/v1/auth/staff/ {
        limit_req zone=ops_auth_zone burst=5 nodelay;
        limit_req zone=staff_auth_zone burst=5 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://api;
    }
    location /api/v1/auth/ {
        limit_req zone=ops_auth_zone burst=5 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://api;
    }
    # Session housekeeping (every page load / token refresh): normal API budget.
    location = /api/v1/auth/staff/refresh {
        limit_req zone=api_zone burst=20 nodelay;
        limit_req zone=api_ip_zone burst=100 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://api;
    }
    location /api/v1/auth/me {
        limit_req zone=api_zone burst=40 nodelay;
        limit_req zone=api_ip_zone burst=100 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://api;
    }

    # ---- API -----------------------------------------------------------------------------------------
    location /api/v1/ws {
        limit_req zone=api_ip_zone burst=50 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_buffering  off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_pass http://api;
    }
    location /api/v1/documents {
        limit_req zone=upload_zone burst=10 nodelay;
        limit_req zone=api_zone burst=40 nodelay;
        limit_req zone=api_ip_zone burst=200 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_pass http://api;
    }
    location /api/v1/admin/reports/export {
        limit_req zone=api_zone burst=10 nodelay;
        limit_req zone=api_ip_zone burst=200 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_pass http://api;
    }
    # Payment webhooks belong to the public domain only.
    location /api/v1/payments/webhooks/ { return 404; }
    location /api/ {
        limit_req zone=api_zone burst=40 nodelay;
        limit_req zone=api_ip_zone burst=200 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_pass http://api;
    }
    location /metrics { return 404; }

    # Nothing else lives on this host.
    location / {
        add_header X-Robots-Tag "noindex, nofollow" always;
        return 404;
    }
}
