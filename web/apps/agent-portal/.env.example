# Agent portal (served at /agent/)
# PLAN 3.1 access doors. Defaults: dev URLs below in `vite` dev, same-origin paths (/login, /app/, ...) in builds.
# Website (public door: sign-in / registration) and where logout lands
VITE_PUBLIC_LOGIN_URL=http://localhost:3000/login
VITE_PUBLIC_REGISTER_URL=http://localhost:3000/register
VITE_PUBLIC_SITE_URL=http://localhost:3000/
# Portal base URLs (a signed-in user who opens another role's portal is sent to their own)
VITE_PATIENT_APP_URL=http://localhost:5173/app/
VITE_AGENT_PORTAL_URL=http://localhost:5174/agent/
VITE_HOSPITAL_PORTAL_URL=http://localhost:5175/hospital/
VITE_ADMIN_PORTAL_URL=http://localhost:5176/gahi/
# Dev server only: where /api (incl. the /api/v1/ws WebSocket) is proxied
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ENABLE_MOCK_PAYMENTS=
# absolute ws(s) URL override for the realtime socket (default: same origin /api/v1/ws)
VITE_WS_URL=
