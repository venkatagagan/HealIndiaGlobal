# Heal India Global public website - copy to .env.local and adjust.
# NEXT_PUBLIC_* values are inlined at BUILD time (rebuild after changing them). The others are read at runtime.

# Canonical origin for canonical URLs, sitemap.xml and OpenGraph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public catalogue API (PLAN section 8.4). API_BASE_URL is used by the server; NEXT_PUBLIC_API_BASE is a fallback.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api/v1
# The contact form POSTs to NEXT_PUBLIC_CONTACT_ENDPOINT, else to {NEXT_PUBLIC_API_BASE}/site/enquiries; with neither
# set it opens a mailto: link. "/api/v1" (production default) is same-origin: nginx in production, the /api/* rewrite
# in `next dev`. An absolute API base is added to the CSP connect-src and must allow this site's origin (CORS).
# NEXT_PUBLIC_CONTACT_ENDPOINT=
# API_TIMEOUT_MS=4000
# ISR revalidation window for catalogue pages, in seconds.
# REVALIDATE_SECONDS=3600
# When to use the offline fallback catalogue: auto (default) | build | off.
# DATA_FALLBACK=auto

# Portals (PLAN section 3.1). In production these are same-origin paths, e.g. https://healindiaglobal.com/app/
NEXT_PUBLIC_PATIENT_APP_URL=http://localhost:5173/app/
NEXT_PUBLIC_AGENT_PORTAL_URL=http://localhost:5174/agent/
NEXT_PUBLIC_HOSPITAL_PORTAL_URL=http://localhost:5175/hospital/
# Staff door: /gahi redirects here in development (nginx serves the admin console at /gahi/ in production).
NEXT_PUBLIC_STAFF_URL=http://localhost:5176/gahi/

# Optional Google sign-in on the login/register pages (adds accounts.google.com to the CSP when set).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Contact details, social links, analytics, verification codes, marketing claims, reviewers and the footer are
# edited by a super admin in the staff console (System -> Website & contact) and read from GET /api/v1/site-config.
# The NEXT_PUBLIC_CONTACT_EMAIL / WHATSAPP / PHONE / SOCIAL_PROFILES / ANALYTICS_* values and the verification /
# IndexNow variables below are FALLBACKS (API unreachable or the setting is empty).
# SITE_CONFIG_REVALIDATE_SECONDS=300   # time-based refresh of those settings (on-demand revalidation is instant)
# CSP_CONFIG_TTL_SECONDS=30            # how long src/proxy.ts caches the analytics origins for the CSP
# Contact page. Without an endpoint the form opens the visitor's email app (mailto:); it never fakes success.
NEXT_PUBLIC_CONTACT_EMAIL=care@healindiaglobal.example
NEXT_PUBLIC_CONTACT_ENDPOINT=
# Floating WhatsApp / Call buttons and footer contact (international format): fallback for the site settings;
# if a number is unset in both places its button is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE_NUMBER=
# Comma-separated https:// profile URLs for Organization JSON-LD sameAs.
NEXT_PUBLIC_SOCIAL_PROFILES=

# Comma-separated origins allowed for remote images (hospital logos, doctor photos), e.g. https://cdn.example.com
IMAGE_REMOTE_ORIGINS=

# Content review gates.
# CONTENT_INCLUDE_DRAFTS: unset = drafts shown (with a "draft" banner) in `next dev`, HIDDEN in production builds
# (only review_status "approved" pages are published). true/false overrides the default either way.
# CONTENT_INCLUDE_DRAFTS=false
# Legal drafts are shown with a "draft" banner unless set to false (set false at launch).
LEGAL_SHOW_DRAFTS=true

# Staging: true = robots.txt disallows everything and every page is noindex (and the sitemap is empty).
SITE_NOINDEX=false

# Production: true = never publish fallback (sample) catalogue data. `next build` FAILS if the API is unreachable,
# and an ISR render that cannot reach the API logs an error and keeps serving the last good page (no noindex
# sample pages). Ignored by `next dev`. Check status at GET /api/health/seo.
# SITE_REQUIRE_LIVE_DATA=true

# On-demand revalidation (POST /api/revalidate, see README). At least 32 random characters; the same value goes in
# the backend's website-revalidation setting. Empty = endpoint disabled (503). Never commit a real value.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# IndexNow (Bing, Yandex, Seznam, ...): when set, /indexnow-key.txt serves the key and every successful
# POST /api/revalidate pings https://api.indexnow.org with the changed page URLs. 8-128 chars of a-z A-Z 0-9 -.
# Pings only happen when NEXT_PUBLIC_SITE_URL is a public https origin and SITE_NOINDEX is not true.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Real-user Web Vitals (LCP, INP, CLS, FCP, TTFB): OFF unless set (build time). Sends metric + page path only, no
# cookies or identifiers. Use /web-vitals for the built-in receiver (logs one JSON line per beacon when
# WEB_VITALS_LOG=true) or an absolute URL of your own collector (its origin is added to the CSP connect-src).
NEXT_PUBLIC_WEB_VITALS_URL=
# NEXT_PUBLIC_WEB_VITALS_SAMPLE=1
# WEB_VITALS_LOG=false

# Search-console ownership meta tags (server env; set for the build too because pages are prerendered).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Analytics: OFF unless set. plausible = cookieless (no banner); ga4 = loads Google Analytics only after the visitor
# accepts the consent banner (consent mode v2, everything denied by default). Build-time values.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=healindiaglobal.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Build helpers (scripts/prebuild.mjs). Defaults point at the monorepo folders next to website/.
# CONTENT_SOURCE_DIR=../content
# LEGAL_SOURCE_DIR=../docs/legal
# DESIGN_SOURCE_DIR=../design
# PYTHON=../backend/.venv/Scripts/python.exe
# NEXT_OUTPUT=standalone
# Build output folder (default .next). `npm run audit:seo` uses .next-audit so it can run next to `next dev`.
# NEXT_DIST_DIR=.next
